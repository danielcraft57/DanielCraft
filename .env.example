PROSPECTLAB_TOKEN=REPLACE_ME

# Base URL de l'API (sans suffixe)
# Ex: https://prospectlab.danielcraft.fr
PROSPECTLAB_BASE_URL=https://prospectlab.danielcraft.fr

# --- Désabonnement (entreprise par URL) ---
# Note optionnelle envoyée lors du désabonnement (peut être utile pour tracer la raison).
PROSPECTLAB_UNSUBSCRIBE_NOTE=Stop aux emails de prospection (depuis le lien de désabonnement)

# Audit site — POST /api/public/website-audit-report (PDF + email)
# PROSPECTLAB_ENDPOINT=https://prospectlab.danielcraft.fr/api/public/website-analysis
# Auth audit (au moins une des deux) :
# PUBLIC_WEBSITE_AUDIT_LEAD_KEY=   # header X-Website-Audit-Key (optionnel si Bearer suffit)
# Audit premium (futur) : POST .../website-audit-report/complete → 202 + task_id
# PROSPECTLAB_AUDIT_EXTRA_INSTRUCTIONS=
# Paramètres scraping optionnels : PROSPECTLAB_AUDIT_MAX_DEPTH, _MAX_WORKERS, _MAX_TIME, _MAX_PAGES
# Limites proxy DanielCraft (fichiers temp) — par utilisateur (email) et par période :
# PROSPECTLAB_FREE_AUDIT_LIMIT_PER_SECOND=1
# PROSPECTLAB_FREE_AUDIT_LIMIT_PER_MINUTE=8
# PROSPECTLAB_FREE_AUDIT_EMAIL_LIMIT=1
# PROSPECTLAB_FREE_AUDIT_EMAIL_WINDOW_SEC=86400
# PROSPECTLAB_FREE_AUDIT_WEBSITE_LIMIT=2
# PROSPECTLAB_FREE_AUDIT_WEBSITE_WINDOW_SEC=86400

# --- Environnement local / dev ---
# Nom de l'environnement conda à activer pour les scripts de dev.
CONDA_ENV=danielcraft

# Base URL utilisée pendant le build (canoniques, OG, sitemaps, etc.).
SITE_BASE=http://localhost:8000

# ============================================
# Déploiement contenu (scripts/deploy-content.ps1)
# ============================================
DEPLOY_SERVER_USER=REPLACE_ME
DEPLOY_SERVER_HOST=REPLACE_ME
DEPLOY_SERVER_PATH=/var/www/example.com
DEPLOY_SITE_BASE=https://example.com
DEPLOY_NGINX_LOG_NAME=example.com
# Optionnel : rsync Cygwin (C:\cygwin64\bin\rsync.exe) — auto-detecte si present.
# Note : Cygwin 3.3.0 peut echouer contre un serveur rsync 3.4+ ; le script bascule alors sur tar+ssh.
DEPLOY_RSYNC_PATH=C:\cygwin64\bin\rsync.exe

# ============================================
# Configuration Email (SMTP)
# ============================================

# Serveur SMTP (host)
MAIL_SERVER=REPLACE_ME

# Port SMTP
MAIL_PORT=587

# True/False pour STARTTLS
MAIL_USE_TLS=True

# True/False : autoriser certificat auto-signé (utile en local/LAN).
MAIL_TLS_ALLOW_SELF_SIGNED=False

# Identifiants SMTP (si requis par le serveur)
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME

# Format conseillé : "Nom <email@domaine>"
MAIL_DEFAULT_SENDER="Daniel Craft <contact@example.com>"

# Destinataire des emails de contact
MAIL_DEFAULT_RECIPIENT="contact@example.com"

# Si true : valide le formulaire et répond success sans envoyer d’email (SMTP/mail() souvent absents en local).
# CONTACT_MAIL_DRY_RUN=true

# ============================================
# Stripe (paiement fiches catalogue /vitrines/)
# ============================================
# Dashboard : https://dashboard.stripe.com/apikeys
# Ne jamais committer les clés live — uniquement dans .env (gitignore).
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Optionnel : protège GET /api/stripe-test.php (?key=...)
# STRIPE_TEST_KEY=change-me-in-production
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Webhook : checkout.session.completed → api/stripe-webhook.php (facture + audit premium)

# ============================================
# Webful Analytics (mesure d'audience RGPD)
# ============================================
# Dashboard : https://webful.fr/ → Ajouter un site → copier le code de tracking
# Ne jamais committer les clés — uniquement dans .env (gitignore).
# WEBFUL_SITE_ID=WBF-XXXXX
# WEBFUL_API_KEY=your_unique_api_key
# WEBFUL_BASE_URL=https://webful.fr

# ============================================
# Prestafacture (devis prestations + factures après paiement Stripe)
# ============================================
# Doc interne : docs/PRESTAFACTURE.md
# Base publique (sans slash final) — le PHP normalise /api → /api/public si besoin.
PRESTAFACTURE_API_BASE=https://prestafacture.com/api/public
# Dev local (backend Prestafacture) :
# PRESTAFACTURE_API_BASE=http://localhost:3000/api/public
# Jeton fact_… (Paramètres → API — Jetons). Plan Pro requis. Scopes minimaux :
#   • Devis site : clients.read, clients.write, devis.read, devis.write, devis.send, produits.read, produits.write
#   • Audit / livres payés Stripe : factures.read, factures.write, factures.send
PRESTAFACTURE_API_TOKEN=REPLACE_ME
# Anciens noms FACTURIO_* encore acceptés en secours.

# ============================================
# Livres PDF — fulfillment Stripe + page téléchargement
# ============================================
# Docs : docs/PRESTAFACTURE.md (flux livres)
# Chemin des PDF (défaut auto : livres-formation/pdf à la racine du projet)
# LIVRE_PDF_DIR=/var/www/danielcraft.fr/livres-formation/pdf
# Stockage tokens / codes (défaut : temp système dc_livre_dl + dc_livre_sec)
# LIVRE_DOWNLOAD_DIR=/var/lib/danielcraft/livre-download
LIVRE_DOWNLOAD_TTL_DAYS=30
LIVRE_DOWNLOAD_MAX_ATTEMPTS=5
LIVRE_DOWNLOAD_LOCK_HOURS=24

# ============================================
# Captures vitrines (scripts/screenshot_vitrines.py)
# ============================================
# WEBSITE_SCREENSHOT_WAIT_MS=700
# Format leger par defaut : webp (jpeg possible via cette variable)
# WEBSITE_SCREENSHOT_CAPTURE_FORMAT=webp
# Post-traitement type cartes portfolio (marge claire + voile bleu + bord) :
# WEBSITE_SCREENSHOT_BRAND_ENABLED=true
# WEBSITE_SCREENSHOT_BRAND_PAD=28
# WEBSITE_SCREENSHOT_BRAND_BLUE_MIX=0.09
# WEBSITE_SCREENSHOT_BRAND_BORDER_WIDTH=2

# Optionnel : si tu utilises sendmail/msmtp et que tu veux forcer sendmail_path
MAIL_SENDMAIL_PATH=

# ============================================
# IONOS DNS API (modifier les enregistrements DNS)
# ============================================
# Header: X-API-Key: prefix.secret
# Docs: https://developer.hosting.ionos.com/docs/dns
# Ne jamais committer les clés — uniquement dans .env (gitignore).
# IONOS_API_PREFIX=REPLACE_ME
# IONOS_API_SECRET=REPLACE_ME
# IONOS_API_KEY=REPLACE_ME.REPLACE_ME

