# Fichiers générés par le build
dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Instructions locales pour agents (non versionné)
AGENT.md
AGENTS.md
agents.md

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# --- Images & binaires lourds (régénérables ou dérivés du build) ---
# Hero, Open Graph, vignettes projet : contenu du dossier ignoré sauf exceptions.
assets/images/hero/*
assets/images/og/*
assets/images/projets/*
!assets/images/projets/placeholder.svg
# WebP dérivés des vignettes (build / pipelines) — les JPG peuvent rester versionnés si besoin
assets/images/projets/*.webp
assets/images/projets/*.WEBP

# Variantes lourdes hero « à propos » (export WebP / essais)
assets/images/about-section-hero.webp
assets/images/about-section-hero-trial-*.png
assets/images/about-section-hero-trial-*.webp

# Captures Playwright vitrines (voir docs/VITRINES.md, scripts/screenshot_vitrines.py)
assets/vitrines/screenshots/**
!assets/vitrines/screenshots/.gitkeep

# QA UX : captures locales et rapport Lighthouse (voir docs/ux-screenshots/README.md)
docs/ux-screenshots/**/*.png
docs/lighthouse-mobile-home.json

# Maquettes démo : versionner assets/vitrines/demos/ (HTML, CSS, images PNG des vitrines).
# Ne pas y committer de captures régénérables : les placer sous assets/vitrines/screenshots/ (ignoré ci-dessus).

# Vendor PHP (téléchargé via scripts/vendor_phpmailer.ps1)
api/vendor/
/vendor/
.phpunit.cache/
composer.phar
composer-setup.php

# Favicons : source SVG + pack PNG/ICO/manifest (régénérer avec scripts/generate_favicon_pngs.py)

# Anciennes versions volumineuses / archives
Previous_Versions/*

# README téléchargés pour les projets (générés)
src/data/readmes/*

# --- Livres de formation (artefacts regenerables) ---
# JPG d'impression : recrees par build_livre.py a partir des PNG source
livres-formation/**/images/print/
# Scripts temporaires de generation / raster (_gen1.py, _thicken.py, ...)
livres-formation/**/_*.py
# HTML assemble (regenerable) : on versionne surtout markdown + images source + PDF
# (decommenter si tu veux alléger encore le depot)
# livres-formation/**/livre.html

# Secrets / config locales
.env
.env.*
.env.local
*.env
*.pem
*.key

# Modèle versionné
!.env.example

dist-test/
coaching/
