# Fichiers générés par le build
dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Images lourdes / générées (Open Graph + hero + projets)
# On ignore les dossiers d'images générées, mais pas les icônes/source légers.
assets/images/hero/*
assets/images/projects/*
assets/images/og/*

# Vendor PHP (téléchargé via scripts/vendor_phpmailer.ps1)
api/vendor/

# Garder le placeholder projet versionné
!assets/images/projects/placeholder.svg

# Favicons : source SVG + pack PNG/ICO/manifest (régénérer avec scripts/generate_favicon_pngs.py)

# Anciennes versions volumineuses / archives
Previous_Versions/*

# README téléchargés pour les projets (générés)
src/data/readmes/*

# Secrets / config locales
.env
.env.*
.env.local
*.env
*.pem
*.key

# Modèle versionné
!.env.example

dist-test/
coaching/
