# Configuration Nginx pour DanielCraft V6 (version sans SSL - pour Certbot)
# Domaine : example.com (remplace par ton domaine)
# Cette version est utilisée AVANT que Certbot crée les certificats SSL
# Certbot ajoutera automatiquement le bloc SSL après création des certificats

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;
    
    # Redirection HTTP vers HTTPS (sera activée par Certbot)
    # return 301 https://$host$request_uri;
    
    # Chemin vers les fichiers du site
    root /var/www/example.com;
    index index.html;

    # Optimisations I/O
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    
    # Headers de sécurité
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    
    # Compression Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json application/xml;
    gzip_proxied any;
    
    # Cache pour les assets statiques
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|pdf)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }
    
    # Cache pour les fichiers HTML (plus court)
    location ~* \.html$ {
        expires 1h;
        add_header Cache-Control "public";
    }
    
    # Pages d'erreur personnalisées
    error_page 404 /404.html;
    error_page 500 502 503 504 /500.html;

    location = /404.html {
        internal;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location = /500.html {
        internal;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # URLs propres (sans .html) : /pro, /nos-offres, /contact, etc.
    # Pour /, on sert index.html sans redirection.
    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }
    
    # Protection des fichiers sensibles
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    location ~ /\.ht {
        deny all;
    }
    
    # Logs
    access_log /var/log/nginx/example.com-access.log;
    error_log /var/log/nginx/example.com-error.log;
    
    # Taille max des uploads (si formulaire de contact)
    client_max_body_size 10M;
}

