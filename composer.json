{
  "name": "danielcraft/site",
  "description": "Site statique DanielCraft — build Python + API PHP",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "DanielCraft\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:php": "phpunit --testsuite php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
